# ---- Required -------------------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# ---- LLM models (Groq) -----------------------------------------------------
# Main model: investigation with tool calling, drafting, escalation
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: triage, evidence check (judge), memory extraction
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ---- Qdrant -----------------------------------------------------------------
# Leave QDRANT_URL empty to use embedded local mode (data/qdrant, single process).
# For the Docker server:  docker run -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
# then set QDRANT_URL=http://localhost:6333 and re-run scripts/ingest.py
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=support_cases

# ---- LangSmith (evaluators + optional tracing) ------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=support-investigation-agent
# EU-region LangSmith accounts: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ---- LLM call settings (no client-side Groq limits: usage is only recorded) --
GROQ_REASONING_EFFORT=low
GROQ_MAX_OUT_MAIN=4096
GROQ_MAX_OUT_FAST=2048
QDRANT_MAX_RPS=5
QDRANT_UPLOAD_BATCH=128

# ---- Agent budgets (optional) ----------------------------------------------
RETRIEVAL_K=6
MAX_TOOL_ROUNDS=2
MAX_EVAL_RETRIES=1
